{
  "mcpServers": {
    "al-mcp": {
      "command": "cmd",
      "args": [
        "/c",
        "${CLAUDE_PLUGIN_ROOT}/tools/environment/run-bash.cmd",
        "${CLAUDE_PLUGIN_ROOT}/tools/al-cli/al-launch.sh",
        "launchmcpserver",
        "--transport",
        "stdio"
      ]
    },
    "nab-al-tools": {
      "command": "npx",
      "args": [
        "-y",
        "@nabsolutions/nab-al-tools-mcp@next"
      ]
    },
    "ms-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "freshdesk": {
      "type": "http",
      "url": "https://dsc-group.freshdesk.com/mcp",
      "headers": {
        "Authorization": "${FRESHDESK_API_KEY:-}"
      }
    },
    "businesscentral": {
      "type": "http",
      "url": "https://mcp.businesscentral.dynamics.com/?c=bc-dev",
      "headers": {
        "TenantId": "644d96ee-d024-41e3-b591-5471e14b5c4b",
        "EnvironmentName": "Production",
        "Company": "DSC GROUP SRL",
        "ConfigurationName": "OPERATIONS"
      },
      "oauth": {
        "clientId": "e79ef7b3-6f90-4d6b-928f-787fea640570",
        "callbackPort": 33418
      }
    }
  }
}

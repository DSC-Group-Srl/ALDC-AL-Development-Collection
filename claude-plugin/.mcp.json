{
  "mcpServers": {
    "al-mcp": {
      "command": "cmd",
      "args": [
        "/c",
        "bash",
        "${CLAUDE_PLUGIN_ROOT}/tools/al-cli/al-launch.sh",
        "launchmcpserver",
        "--transport",
        "stdio"
      ]
    },
    "nab-al-tools": {
      "command": "npx",
      "args": [
        "-y",
        "@nabsolutions/nab-al-tools-mcp@next"
      ]
    },
    "ms-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "freshdesk": {
      "type": "http",
      "url": "https://dsc-group.freshdesk.com/mcp",
      "headers": {
        "Authorization": "${FRESHDESK_API_KEY:-}"
      }
    }
  }
}
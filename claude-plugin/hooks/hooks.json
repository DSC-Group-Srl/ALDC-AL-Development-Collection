{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd",
            "args": [
              "/c",
              "bash",
              "${CLAUDE_PLUGIN_ROOT}/tools/hooks/sessionstart.sh",
              "SessionStart"
            ],
            "timeout": 120
          },
          {
            "type": "command",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}/tools/environment/git-bash-check.ps1\" SessionStart",
            "shell": "powershell",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd",
            "args": [
              "/c",
              "bash",
              "${CLAUDE_PLUGIN_ROOT}/tools/hooks/pretooluse.sh"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd",
            "args": [
              "/c",
              "bash",
              "${CLAUDE_PLUGIN_ROOT}/tools/metrics/session_end.sh"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd",
            "args": [
              "/c",
              "bash",
              "${CLAUDE_PLUGIN_ROOT}/tools/metrics/capture_subagent.sh"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}

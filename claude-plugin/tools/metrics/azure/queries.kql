// ALDC quality metrics — KQL for Application Insights.
//
// Every record the plugin sends is one row in `customEvents` with name == "AldcPhase".
// Dimensions (strings you group by) live in customDimensions; measures (numbers you
// aggregate) live in customMeasurements and must be unpacked with todouble().
//
// Paste any single block into Logs on the Application Insights resource. Each block ends
// with ";" so Logs also accepts the whole file pasted at once and runs it as a batch of
// queries (Application Insights would otherwise parse two un-terminated tabular blocks as
// one continuous query and fail with e.g. "could not be parsed at 'customEvents'"). The
// workbook in workbook.json wires the first four up as tiles.

// ---------------------------------------------------------------------------
// 0. Everything, most recent first. Start here when you are not sure what you have.
// ---------------------------------------------------------------------------
customEvents
| where name == "AldcPhase"
| project timestamp,
          project_ = tostring(customDimensions.['project']),
          agent    = tostring(customDimensions.agent),
          phase    = toint(customDimensions.phase),
          verdict  = tostring(customDimensions.verdict),
          prescribed = todouble(customMeasurements.prescribed),
          applied    = todouble(customMeasurements.applied),
          deviated   = todouble(customMeasurements.deviated),
          undeclared = todouble(customMeasurements.undeclared),
          cited      = todouble(customMeasurements.cited),
          agentFindings = todouble(customMeasurements.agentFindings),
          independenceRatio = todouble(customMeasurements.independenceRatio)
| order by timestamp desc;

// ---------------------------------------------------------------------------
// 1. THE ONE THAT MATTERS — independence-ratio over time.
//
// agent findings / total findings. Implementer and reviewer draw on the same corpus, so
// the review can quietly stop being a measurement and become a consistency check. This is
// the only number that shows it happening. Below 0.15 is weakening; at 0 the review has
// stopped measuring. Computed from the sums, not as an average of ratios — a mean of
// ratios would let a phase with two findings outvote one with twenty.
// ---------------------------------------------------------------------------
customEvents
| where name == "AldcPhase" and tostring(customDimensions.agent) == "al-review-subagent"
| summarize agentFindings = sum(todouble(customMeasurements.agentFindings)),
            totalFindings = sum(todouble(customMeasurements.totalFindings))
          by bin(timestamp, 7d)
| extend independenceRatio = iff(totalFindings > 0, agentFindings / totalFindings, 0.0)
| extend health = case(isnull(independenceRatio), "no data",
                       independenceRatio >= 0.15, "healthy",
                       independenceRatio > 0,     "LOW - valve weakening",
                                                  "ZERO - review is only agreeing")
| project timestamp, independenceRatio, agentFindings, totalFindings, health
| render timechart;

// ---------------------------------------------------------------------------
// 2. Undeclared deviations — must be zero.
//
// Non-zero means the implementer is not reading the prescribed worklist, which makes every
// other number here meaningless. Grouped by project so you know where to look.
// ---------------------------------------------------------------------------
customEvents
| where name == "AldcPhase" and tostring(customDimensions.agent) == "al-review-subagent"
| summarize undeclared = sum(todouble(customMeasurements.undeclared)),
            phases = count()
          by project_ = tostring(customDimensions.['project'])
| where undeclared > 0
| order by undeclared desc;

// ---------------------------------------------------------------------------
// 3. Deviation rate, and which article keeps being deviated from.
//
// An article deviated repeatedly is not an implementer problem: it is a rule that does not
// fit how we build, and it belongs in /custom/ as an override. This query names it.
// ---------------------------------------------------------------------------
customEvents
| where name == "AldcPhase"
| where isnotempty(tostring(customDimensions.deviationsDeclared))
| extend paths = split(tostring(customDimensions.deviationsDeclared), "|")
| mv-expand path = paths to typeof(string)
| summarize deviations = count(),
            projects = dcount(tostring(customDimensions.['project']))
          by path
| order by deviations desc
| take 20;

// ---------------------------------------------------------------------------
// 4. Prescriptive coverage — is the prescribed worklist scoped correctly?
//
// `cited` counts what the review found on its own in domains it was NOT prescribed. High
// relative to `prescribed` means the prescriptive pass is too narrow and the review keeps
// picking up what planning should have handed the implementer.
// ---------------------------------------------------------------------------
customEvents
| where name == "AldcPhase" and tostring(customDimensions.agent) == "al-review-subagent"
| summarize prescribed = sum(todouble(customMeasurements.prescribed)),
            applied    = sum(todouble(customMeasurements.applied)),
            cited      = sum(todouble(customMeasurements.cited))
          by project_ = tostring(customDimensions.['project'])
| extend appliedPct = iff(prescribed > 0, applied / prescribed, 0.0),
         citedVsPrescribed = iff(prescribed > 0, cited / prescribed, 0.0)
| order by citedVsPrescribed desc;

// ---------------------------------------------------------------------------
// 5. Verdict mix per project — the outcome side, for context.
// ---------------------------------------------------------------------------
customEvents
| where name == "AldcPhase" and isnotempty(tostring(customDimensions.verdict))
| summarize phases = count() by project_ = tostring(customDimensions.['project']),
                                verdict = tostring(customDimensions.verdict)
| render columnchart kind=stacked;

// ---------------------------------------------------------------------------
// 6. Most-cited knowledge — what the corpus is actually catching.
//
// Useful in the other direction too: a Microsoft article that never appears here across
// many phases is either irrelevant to our work or not being retrieved at all.
// ---------------------------------------------------------------------------
customEvents
| where name == "AldcPhase" and isnotempty(tostring(customDimensions.knowledge))
| extend paths = split(tostring(customDimensions.knowledge), "|")
| mv-expand path = paths to typeof(string)
| summarize citations = count(), projects = dcount(tostring(customDimensions.['project'])) by path
| order by citations desc
| take 20;

// ---------------------------------------------------------------------------
// 7. Health check — runs where BCQuality was not mounted.
//
// These contribute no prescriptions and skew every ratio above. A steady trickle means a
// SessionStart hook that is not landing on someone's machine.
// ---------------------------------------------------------------------------
customEvents
| where name == "AldcPhase"
| summarize notMounted = countif(tostring(customDimensions.bcqMounted) == "false"),
            total = count()
          by project_ = tostring(customDimensions.['project']),
             bin(timestamp, 7d)
| where notMounted > 0
| extend pctNotMounted = 100.0 * notMounted / total
| order by timestamp desc;

// ---------------------------------------------------------------------------
// 8. Which BCQuality pin is in the field.
//
// After a pin bump PR merges, this shows how fast the estate actually picks it up — the
// hook refreshes at most every 12h, so a lagging machine is visible here.
// ---------------------------------------------------------------------------
customEvents
| where name == "AldcPhase" and isnotempty(tostring(customDimensions.bcqSha))
| summarize phases = count(), lastSeen = max(timestamp)
          by bcqSha = tostring(customDimensions.bcqSha)
| order by lastSeen desc;

// ---------------------------------------------------------------------------
// 9. What version is actually deployed — AldcHeartbeat, not AldcPhase.
//
// Fires on every SessionStart, so it does not wait for anyone to run a review: everyone
// updates the plugin before everyone runs one. One row per machine per day at most, plus
// one extra row the moment a machine's version changes.
// ---------------------------------------------------------------------------
customEvents
| where name == "AldcHeartbeat"
| summarize machines = dcount(tostring(customDimensions.['project'])),
            lastSeen = max(timestamp)
          by pluginVersion = tostring(customDimensions.pluginVersion)
| order by lastSeen desc;

// ---------------------------------------------------------------------------
// 10. Upgrade events — who moved, from what, to what, and when.
//
// customDimensions.upgraded == "true" is set only on the row where the version actually
// changed on that machine, so this is a rollout timeline, not just a version count.
// ---------------------------------------------------------------------------
customEvents
| where name == "AldcHeartbeat" and tostring(customDimensions.upgraded) == "true"
| project timestamp,
          project_ = tostring(customDimensions.['project']),
          from_ = tostring(customDimensions.previousVersion),
          to_ = tostring(customDimensions.pluginVersion)
| order by timestamp desc;

// ===========================================================================
// EFFICIENCY (bc-dev >= 8.0) — tokens, time, cost, parallelism, test lane.
// AldcPhase rows now carry u* measurements (uTokensTotal, uTokensOutput, uWallSeconds,
// uTurns, uBuilds, uReadsWhole, uReadsRanged, …) and a `model` dimension. New event
// names: AldcSession (SessionEnd total incl. subagents), AldcRun (conductor run),
// AldcLane (one test-lane run), AldcRead (read-guard), AldcHook.
// ===========================================================================

// E1. Tokens and wall-clock per agent, per plugin version.
customEvents
| where name == "AldcPhase" and isnotempty(customMeasurements.uTokensTotal)
| summarize runs = count(),
            avgTokens = avg(todouble(customMeasurements.uTokensTotal)),
            avgOutput = avg(todouble(customMeasurements.uTokensOutput)),
            avgWallS  = avg(todouble(customMeasurements.uWallSeconds)),
            avgBuilds = avg(todouble(customMeasurements.uBuilds)),
            wholeReads = sum(todouble(customMeasurements.uReadsWhole)),
            rangedReads = sum(todouble(customMeasurements.uReadsRanged))
  by agent = tostring(customDimensions.agent), version = tostring(customDimensions.pluginVersion)
| extend wholeReadShare = round(wholeReads / (wholeReads + rangedReads), 2)
| order by version desc, avgTokens desc;

// E2. Session totals by plugin version — the before/after number for every release.
customEvents
| where name == "AldcSession"
| summarize sessions = count(),
            avgTokens = avg(todouble(customMeasurements.tokensTotal)),
            p50Tokens = percentile(todouble(customMeasurements.tokensTotal), 50),
            avgWallMin = avg(todouble(customMeasurements.wallSeconds)) / 60,
            avgTokensPerAlLine = avg(todouble(customMeasurements.tokensPerAlLine))
  by version = tostring(customDimensions.pluginVersion)
| order by version desc;

// E3. Conductor runs: shape of the work (WPs, waves, fix loops, human stops, parallelism).
customEvents
| where name == "AldcRun"
| project timestamp, version = tostring(customDimensions.pluginVersion),
          tier = tostring(customDimensions.tier), lane = tostring(customDimensions.lane),
          wps = todouble(customMeasurements.wps), waves = todouble(customMeasurements.waves),
          fixLoops = todouble(customMeasurements.fixLoops), stops = todouble(customMeasurements.stops),
          parallelism = todouble(customMeasurements.parallelism),
          alLines = todouble(customMeasurements.alAdded) + todouble(customMeasurements.alRemoved)
| order by timestamp desc;

// E4. Test lane: where the serial bottleneck time goes.
customEvents
| where name == "AldcLane"
| summarize runs = count(), avgLockWaitS = avg(todouble(customMeasurements.lockWaitS)),
            avgPublishS = avg(todouble(customMeasurements.publishS)),
            avgRunS = avg(todouble(customMeasurements.runS)),
            failed = sum(todouble(customMeasurements.failed)),
            staleRecovered = sum(todouble(customMeasurements.staleRecovered))
  by bin(timestamp, 1d), result = tostring(customDimensions.result)
| order by timestamp desc;

// E5. Read-guard: whole-file reads blocked and the context they would have cost.
customEvents
| where name == "AldcRead"
| summarize events = count(), chars = sum(todouble(customMeasurements.chars))
  by action = tostring(customDimensions.action), bin(timestamp, 1d)
| extend estTokensAvoided = iff(action == "blocked", chars / 4, 0.0)
| order by timestamp desc;

// L1. Live: sessions seen in the last 10 minutes and where their conductor run is.
customEvents
| where timestamp > ago(10m) and name in ("AldcAlive", "AldcRunStart", "AldcWave", "AldcWp", "AldcLane")
| summarize lastSeen = max(timestamp), agent = take_anyif(tostring(customDimensions.agent), name == "AldcAlive"),
            req = take_any(tostring(customDimensions.req)),
            wave = max(todouble(customMeasurements.wave)), waves = max(todouble(customMeasurements.waves))
  by user = tostring(customDimensions.user), session = tostring(customDimensions.session),
     project = tostring(customDimensions.project), where = tostring(customDimensions.where)
| order by lastSeen desc;

// L2. Median wave and WP duration per tier — what the panel's ETA is built from.
customEvents
| where timestamp > ago(90d) and name in ("AldcWave", "AldcWp") and customDimensions.stage == "end"
| extend tier = tostring(customDimensions.tier), d = todouble(customMeasurements.durationS)
| summarize n = count(), p50 = percentile(d, 50), p80 = percentile(d, 80) by name, project = tostring(customDimensions.project);

// ===========================================================================
// ESTIMATION (record schema 3) — duration ~ planned scope.
// One task = one runId (project:req:user). AldcEstimate is the ex-ante scope parsed from the
// plan before wave 1 (only parsed plans, parseOk = 1: plans started before 8.8 have no
// Planned objects table); AldcRun is the ex-post size and the MEASURED time. Runs before
// 6 Oct 2026 have no runId and drop out; pre-schema-3 wallMinutes was the model's guess.
//
// Time is robust to the attempt registry being per machine (a cloud session with an ephemeral
// home, a resume on another PC restarts `attempt` at 1 and skips the local dedupe): AldcRun
// rows are de-duplicated on runId + attempt + activeSeconds, their activeSeconds summed, and
// the larger of that sum and the registry's own activeSecondsTotal is kept.
//
// Switches at the top of each block: includeExcluded (dry runs, self-tests —
// ALDC_METRICS_EXCLUDE=1) and includeRework (a req started again after it finished `done`
// gets its own runId and rework >= 1; excluded by default, its plan is usually the old one).
// ===========================================================================

// X1. estimation_dataset — one row per task: planned features, delivered size, time, tokens.
let includeExcluded = false;
let includeRework = false;
let minSchema = 3;
let ev = (n: string) { customEvents
    | where name == n and toint(customDimensions.schema) >= minSchema
    | where includeExcluded or tostring(customDimensions.exclude) != "true"
    | extend runId = tostring(customDimensions.runId)
    | where isnotempty(runId) };
let runTime = ev("AldcRun")
    | extend attempt = todouble(customMeasurements.attempt), activeS = todouble(customMeasurements.activeSeconds)
    | summarize arg_max(timestamp, customDimensions, customMeasurements) by runId, attempt, activeS
    | summarize activeSum = sum(activeS), registryTotal = max(todouble(customMeasurements.activeSecondsTotal)),
                humanWaitSeconds = sum(todouble(customMeasurements.humanWaitSeconds)),
                waveSeconds = sum(todouble(customMeasurements.waveSeconds)),
                runRows = count(), maxAttempts = max(todouble(customMeasurements.attempts)),
                doneRows = countif(tostring(customDimensions.outcome) == "done"),
                rework = max(coalesce(todouble(customMeasurements.rework), 0.0)) by runId
    | where doneRows > 0 and (includeRework or rework == 0)
    | extend activeSecondsTotal = max_of(activeSum, coalesce(registryTotal, 0.0)),
             attempts = max_of(coalesce(maxAttempts, 0.0), todouble(runRows))
    | project runId, activeSecondsTotal, humanWaitSeconds, waveSeconds, attempts, rework;
let est = ev("AldcEstimate")
    | summarize arg_max(timestamp, customDimensions, customMeasurements) by runId
    | mv-apply k = bag_keys(customMeasurements) to typeof(string) on (
        where k startswith "obj_" | summarize objPlanned = make_bag(bag_pack(k, customMeasurements[k])))
    | project runId, estimatedAt = timestamp, req = tostring(customDimensions.req),
              tier = tostring(customDimensions.tier), model = tostring(customDimensions.model),
              estSource = tostring(customDimensions.estSource), issueNo = tostring(customDimensions.issueNo),
              parseOk = todouble(customMeasurements.parseOk),
              objTotal = todouble(customMeasurements.objTotal), objWeighted = todouble(customMeasurements.objWeighted),
              testCodeunitsPlanned = todouble(customMeasurements.testCodeunitsPlanned),
              wpsPlanned = todouble(customMeasurements.wpsPlanned), wavesPlanned = todouble(customMeasurements.wavesPlanned),
              openQuestions = todouble(customMeasurements.openQuestions),
              hasIntegration = todouble(customMeasurements.hasIntegration), hasEvents = todouble(customMeasurements.hasEvents),
              hasApi = todouble(customMeasurements.hasApi), appObjectCount = todouble(customMeasurements.appObjectCount),
              estP50Min = todouble(customMeasurements.estP50Min), estP80Min = todouble(customMeasurements.estP80Min),
              objPlanned
    | where parseOk == 1;
let run = ev("AldcRun")
    | where tostring(customDimensions.outcome) == "done"
    | summarize arg_max(timestamp, customDimensions, customMeasurements) by runId
    | mv-apply k = bag_keys(customMeasurements) to typeof(string) on (
        where k startswith "objDone_" | summarize objDone = make_bag(bag_pack(k, customMeasurements[k])))
    | project runId, finishedAt = timestamp, project_ = tostring(customDimensions.['project']),
              user = tostring(customDimensions.user), pluginVersion = tostring(customDimensions.pluginVersion),
              wallMinutesTotal = todouble(customMeasurements.wallMinutesTotal),
              reportedMinutes = todouble(customMeasurements.reportedMinutes),
              fixLoops = todouble(customMeasurements.fixLoops), stops = todouble(customMeasurements.stops),
              wps = todouble(customMeasurements.wps), waves = todouble(customMeasurements.waves),
              testsPassed = todouble(customMeasurements.testsPassed), testsFailed = todouble(customMeasurements.testsFailed),
              alAdded = todouble(customMeasurements.alAdded), alRemoved = todouble(customMeasurements.alRemoved),
              alAddedProd = todouble(customMeasurements.alAddedProd), alAddedTest = todouble(customMeasurements.alAddedTest),
              objDone;
let phaseTokens = customEvents
    | where name == "AldcPhase" and (includeExcluded or tostring(customDimensions.exclude) != "true")
    | extend runId = tostring(customDimensions.runId)
    | where isnotempty(runId)
    | summarize phases = count(), phaseTokens = sum(todouble(customMeasurements.uTokensTotal)),
                phaseOutputTokens = sum(todouble(customMeasurements.uTokensOutput)) by runId;
let sessionTokens = customEvents
    | where name == "AldcSession" and (includeExcluded or tostring(customDimensions.exclude) != "true")
    | extend runId = tostring(customDimensions.runId)
    | where isnotempty(runId)
    | summarize sessions = count(), sessionTokens = sum(todouble(customMeasurements.tokensTotal)) by runId;
est
| join kind=inner runTime on runId
| join kind=inner run on runId
| join kind=leftouter phaseTokens on runId
| join kind=leftouter sessionTokens on runId
| project-away runId1, runId2, runId3, runId4
| extend activeMin = round(activeSecondsTotal / 60, 1)
| order by finishedAt desc;

// X2. estimation_calibration — is the P80 an 80% bound? Target shareWithinP80 ≈ 0.8, and a
// median actual/P50 near 1. Only tasks that came with an estimate (estP80Min).
let includeExcluded = false;
let includeRework = false;
let minSchema = 3;
let ev = (n: string) { customEvents
    | where name == n and toint(customDimensions.schema) >= minSchema
    | where includeExcluded or tostring(customDimensions.exclude) != "true"
    | extend runId = tostring(customDimensions.runId)
    | where isnotempty(runId) };
let runTime = ev("AldcRun")
    | extend attempt = todouble(customMeasurements.attempt), activeS = todouble(customMeasurements.activeSeconds)
    | summarize arg_max(timestamp, customDimensions, customMeasurements) by runId, attempt, activeS
    | summarize activeSum = sum(activeS), registryTotal = max(todouble(customMeasurements.activeSecondsTotal)),
                finishedAt = maxif(timestamp, tostring(customDimensions.outcome) == "done"),
                doneRows = countif(tostring(customDimensions.outcome) == "done"),
                rework = max(coalesce(todouble(customMeasurements.rework), 0.0)) by runId
    | where doneRows > 0 and (includeRework or rework == 0)
    | project runId, finishedAt, activeMin = max_of(activeSum, coalesce(registryTotal, 0.0)) / 60;
ev("AldcEstimate")
| summarize arg_max(timestamp, customDimensions, customMeasurements) by runId
| where todouble(customMeasurements.parseOk) == 1
| project runId, tier = tostring(customDimensions.tier),
          estP50Min = todouble(customMeasurements.estP50Min), estP80Min = todouble(customMeasurements.estP80Min)
| where estP80Min > 0
| join kind=inner runTime on runId
| extend withinP80 = toint(activeMin <= estP80Min), ratioP50 = iff(estP50Min > 0, activeMin / estP50Min, real(null))
| summarize runs = count(), shareWithinP80 = round(avg(withinP80), 2),
            medianActualOverP50 = round(percentile(ratioP50, 50), 2)
  by week = startofweek(finishedAt), tier
| order by week desc, tier asc;

// X3. scope_drift — planned (AldcEstimate obj_*) vs delivered (AldcRun objDone_*) objects per
// kind and New/Ext, over finished tasks. A kind that is always under-planned is where the
// estimate's input is wrong, not its model.
let includeExcluded = false;
let includeRework = false;
let minSchema = 3;
let ev = (n: string) { customEvents
    | where name == n and toint(customDimensions.schema) >= minSchema
    | where includeExcluded or tostring(customDimensions.exclude) != "true"
    | extend runId = tostring(customDimensions.runId)
    | where isnotempty(runId) };
ev("AldcEstimate")
| summarize arg_max(timestamp, customMeasurements) by runId
| where todouble(customMeasurements.parseOk) == 1
| project runId, pm = customMeasurements
| join kind=inner (ev("AldcRun")
    | where tostring(customDimensions.outcome) == "done"
    | summarize arg_max(timestamp, customMeasurements) by runId
    | where includeRework or coalesce(todouble(customMeasurements.rework), 0.0) == 0
    | project runId, dm = customMeasurements) on runId
| mv-expand k = bag_keys(pm) to typeof(string)
| where k startswith "obj_"
| extend key = substring(k, 4)
| extend objKind = tostring(split(key, "_")[0]), change = tostring(split(key, "_")[1]),
         planned = todouble(pm[k]), done = coalesce(todouble(dm[strcat("objDone_", key)]), 0.0)
| summarize tasks = dcount(runId), planned = sum(planned), done = sum(done) by objKind, change
| where planned > 0 or done > 0
| extend drift = done - planned,
         driftPct = iff(planned > 0, round(100.0 * (done - planned) / planned, 0), real(null))
| order by abs(drift) desc;

// X4. active_time_check — does activeSeconds miss work? Per attempt, the time inside waves
// (waveSeconds = Σ wave durationS) is a floor for it: a wave is work from start to end. Rows
// returned here are runs whose clock undercounted; a steady stream means the gap rule in
// emit.py (_tick) is losing silent steps and needs a look.
let includeExcluded = false;
let minSchema = 3;
customEvents
| where name == "AldcRun" and toint(customDimensions.schema) >= minSchema
| where includeExcluded or tostring(customDimensions.exclude) != "true"
| extend runId = tostring(customDimensions.runId), attempt = todouble(customMeasurements.attempt),
         activeS = todouble(customMeasurements.activeSeconds), waveS = todouble(customMeasurements.waveSeconds)
| where isnotempty(runId) and waveS > 0
| summarize arg_max(timestamp, customDimensions) by runId, attempt, activeS, waveS
| extend ratio = round(activeS / waveS, 2), tier = tostring(customDimensions.tier)
| where ratio < 1
| project timestamp, runId, attempt, tier, activeMin = round(activeS / 60, 1), waveMin = round(waveS / 60, 1), ratio
| order by ratio asc;

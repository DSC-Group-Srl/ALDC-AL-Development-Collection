{
  "mcpServers": {
    "al-mcp": {
      "command": "cmd",
      "args": [
        "/c",
        "bash",
        "claude-plugin/tools/al-cli/al-launch.sh",
        "launchmcpserver",
        "--transport",
        "stdio"
      ]
    },
    "ms-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {}
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "env": {}
    }
  }
}
